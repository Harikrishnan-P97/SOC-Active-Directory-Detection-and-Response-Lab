    <description>
        DET-023 - Possible NTDS credential dumping via ntdsutil IFM: $(win.eventdata.image) executed with command $(win.eventdata.commandLine) by $(win.eventdata.user)
    </description>

    <mitre>
        <id>T1003.003</id>
    </mitre>

    <group>
        custom_detection_engineering,
        windows,
        credential_access,
        credential_dumping,
        ntds,
        attack.t1003.003
    </group>
</rule>

